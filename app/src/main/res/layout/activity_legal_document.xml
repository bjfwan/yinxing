<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/legal_document_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page_gradient"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="@dimen/launcher_spacing_md"
        android:paddingEnd="@dimen/launcher_spacing_md">

        <ImageButton
            android:id="@+id/legal_document_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_weather_toolbar_action"
            android:contentDescription="@string/action_back"
            android:padding="@dimen/launcher_spacing_md"
            android:src="@drawable/ic_weather_detail_back" />

        <TextView
            style="@style/TextAppearance.OldLauncher.PageTitle"
            android:id="@+id/legal_document_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/legal_document_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/launcher_action_dark" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/legal_document_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/launcher_surface" />

        <LinearLayout
            android:id="@+id/legal_document_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_settings_page_gradient"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/launcher_spacing_xxl"
            android:paddingEnd="@dimen/launcher_spacing_xxl"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                style="@style/TextAppearance.OldLauncher.StateTitle"
                android:text="@string/settings_legal_load_failed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_sm"
                android:gravity="center"
                style="@style/TextAppearance.OldLauncher.StateBody"
                android:text="@string/settings_legal_load_failed_hint" />

            <TextView
                android:id="@+id/legal_document_retry"
                android:layout_width="180dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/launcher_spacing_xl"
                android:background="@drawable/bg_weather_retry_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                android:text="@string/settings_legal_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
