<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/legal_document_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page_gradient"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/legal_document_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_weather_toolbar_action"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_weather_detail_back" />

        <TextView
            android:id="@+id/legal_document_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/launcher_text_primary"
            android:textSize="21sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/legal_document_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/launcher_action_dark" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/legal_document_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/launcher_surface" />

        <LinearLayout
            android:id="@+id/legal_document_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_settings_page_gradient"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/settings_legal_load_failed"
                android:textColor="@color/launcher_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/settings_legal_load_failed_hint"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/legal_document_retry"
                android:layout_width="180dp"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_weather_retry_button"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:text="@string/settings_legal_retry"
                android:textColor="@color/launcher_on_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
