<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_danger_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/launcher_spacing_xxl"
        android:paddingTop="@dimen/launcher_spacing_xxl"
        android:paddingEnd="@dimen/launcher_spacing_xxl"
        android:paddingBottom="@dimen/launcher_spacing_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            style="@style/TextAppearance.OldLauncher.PageTitle"
            android:text="@string/fall_alert_title"
            android:textColor="@color/launcher_danger" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_lg"
            android:gravity="center"
            style="@style/TextAppearance.OldLauncher.StateBody"
            android:text="@string/fall_alert_message"
            android:textColor="@color/launcher_text_primary" />

        <TextView
            android:id="@+id/fall_alert_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            style="@style/TextAppearance.OldLauncher.HeroTitle"
            android:gravity="center"
            android:textColor="@color/launcher_danger" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            style="@style/TextAppearance.OldLauncher.SectionSubtitle"
            android:text="@string/fall_alert_countdown_hint" />

        <TextView
            style="@style/TextAppearance.OldLauncher.PageSubtitle"
            android:id="@+id/fall_alert_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            android:gravity="center" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fall_alert_cancel"
            style="@style/Widget.OldLauncher.DialogButtonSuccess"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="@dimen/launcher_spacing_xxl">

            <TextView
                style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/fall_alert_cancel" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fall_alert_call_now"
            style="@style/Widget.OldLauncher.DialogButtonDanger"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="@dimen/launcher_spacing_md">

            <TextView
                style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/fall_alert_call_now" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
