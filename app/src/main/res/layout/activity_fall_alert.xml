<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_danger_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="32dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/fall_alert_title"
            android:textColor="@color/launcher_danger"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/fall_alert_message"
            android:textColor="@color/launcher_text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/fall_alert_countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/launcher_danger"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/fall_alert_countdown_hint"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/fall_alert_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/launcher_text_secondary"
            android:textSize="17sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fall_alert_cancel"
            style="@style/Widget.OldLauncher.DialogButtonSuccess"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="26dp"
            app:cardCornerRadius="24dp">

            <TextView
                style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/fall_alert_cancel"
                android:textSize="28sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fall_alert_call_now"
            style="@style/Widget.OldLauncher.DialogButtonDanger"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="22dp">

            <TextView
                style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/fall_alert_call_now"
                android:textSize="22sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
