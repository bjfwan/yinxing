<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="98dp"
    android:layout_height="174dp"
    android:baselineAligned="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/launcher_spacing_sm"
    android:paddingTop="@dimen/launcher_spacing_sm"
    android:paddingEnd="@dimen/launcher_spacing_sm"
    android:paddingBottom="@dimen/launcher_spacing_sm">

    <TextView
        android:id="@+id/tv_hour_label"
        style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1" />

    <TextView
        android:id="@+id/tv_hour_time"
        style="@style/TextAppearance.OldLauncher.DialogSupporting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_xs" />

    <ImageView
        android:id="@+id/iv_hour_weather"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginTop="@dimen/launcher_spacing_sm"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="@dimen/launcher_spacing_xs" />

    <TextView
        android:id="@+id/tv_hour_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_xs"
        style="@style/TextAppearance.OldLauncher.Meta"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/launcher_text_primary" />

    <TextView
        android:id="@+id/tv_hour_temperature"
        style="@style/TextAppearance.OldLauncher.ListTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_hour_precipitation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_xs"
        style="@style/TextAppearance.OldLauncher.Caption"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/weather_precipitation" />
</LinearLayout>
