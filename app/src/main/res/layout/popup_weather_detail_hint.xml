<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_hint_tail"
        android:layout_width="14dp"
        android:layout_height="7dp"
        android:layout_gravity="end"
        android:layout_marginEnd="24dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_weather_detail_hint_tail" />

    <TextView
        android:id="@+id/tv_hint_text"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_weather_detail_hint"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="1.5"
        android:text="@string/home_weather_detail_hint"
        android:textColor="@color/launcher_on_primary"
        android:textSize="15sp" />

</LinearLayout>
