<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    app:cardBackgroundColor="@color/launcher_surface"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/detail_row_click_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/detail_row_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_settings_icon_plate"
            android:importantForAccessibility="no"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detail_row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/launcher_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_row_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_row_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:textColor="@color/launcher_action_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <com.yinxing.launcher.feature.settings.SettingsToggle
            android:id="@+id/detail_row_switch"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/detail_row_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings_action_forward"
            android:visibility="gone"
            app:tint="@color/launcher_text_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
