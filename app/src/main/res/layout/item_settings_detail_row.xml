<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    app:cardBackgroundColor="@color/launcher_surface"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/detail_row_click_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/launcher_spacing_md"
        android:paddingTop="@dimen/launcher_spacing_sm"
        android:paddingEnd="@dimen/launcher_spacing_md"
        android:paddingBottom="@dimen/launcher_spacing_sm">

        <ImageView
            android:id="@+id/detail_row_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_settings_icon_plate"
            android:importantForAccessibility="no"
            android:padding="@dimen/launcher_spacing_sm" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/launcher_spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.OldLauncher.ListTitle"
                android:id="@+id/detail_row_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/detail_row_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_xs"
                android:ellipsize="end"
                style="@style/TextAppearance.OldLauncher.Meta"
                android:maxLines="2" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_row_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingStart="@dimen/launcher_spacing_sm"
            android:paddingEnd="@dimen/launcher_spacing_sm"
            style="@style/TextAppearance.OldLauncher.Meta"
            android:textColor="@color/launcher_action_dark"
            android:visibility="gone" />

        <com.yinxing.launcher.feature.settings.SettingsToggle
            android:id="@+id/detail_row_switch"
            android:layout_width="42dp"
            android:layout_height="32dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/detail_row_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_settings_action_forward"
            android:visibility="gone"
            app:tint="@color/launcher_text_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
