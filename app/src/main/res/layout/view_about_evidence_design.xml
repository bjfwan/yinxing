<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/launcher_spacing_lg">

    <TextView
        style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_about_design_title" />

    <TextView
        style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_md"
        android:text="@string/settings_about_design_overview" />

    <TextView
        style="@style/TextAppearance.OldLauncher.DialogSupporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_md"
        android:lineSpacingExtra="@dimen/launcher_spacing_xs"
        android:text="@string/settings_about_design_body" />
</LinearLayout>
