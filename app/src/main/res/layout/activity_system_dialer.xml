<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/system_dialer_title"
        android:textColor="@color/launcher_text_primary"
        android:textSize="34sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_system_dialer_number"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/edit_text_background"
        android:gravity="center"
        android:hint="@string/system_dialer_number_hint"
        android:importantForAutofill="no"
        android:inputType="phone"
        android:maxLines="1"
        android:textColor="@color/launcher_text_primary"
        android:textSize="30sp" />

    <Button
        android:id="@+id/btn_system_dialer_call"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="28dp"
        android:text="@string/action_call"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_system_dialer_close"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="@string/action_cancel"
        android:textSize="22sp" />

</LinearLayout>
