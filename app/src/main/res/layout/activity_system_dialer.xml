<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/launcher_spacing_xxl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.OldLauncher.PageTitle"
        android:text="@string/system_dialer_title" />

    <EditText
        android:id="@+id/et_system_dialer_number"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="@dimen/launcher_spacing_xxl"
        android:background="@drawable/edit_text_background"
        android:gravity="center"
        android:hint="@string/system_dialer_number_hint"
        android:importantForAutofill="no"
        android:inputType="phone"
        android:maxLines="1"
        style="@style/TextAppearance.OldLauncher.Input" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_system_dialer_call"
        style="@style/Widget.OldLauncher.DialogButtonPrimary"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="@dimen/launcher_spacing_xxl">

        <TextView
            style="@style/TextAppearance.OldLauncher.ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/action_call" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/btn_system_dialer_close"
        style="@style/Widget.OldLauncher.DialogButtonSecondary"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/launcher_spacing_lg">

        <TextView
            style="@style/TextAppearance.OldLauncher.ButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/action_cancel" />
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
