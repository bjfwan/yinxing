<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/family_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page_gradient"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/launcher_spacing_xl"
        android:paddingTop="@dimen/launcher_spacing_xl"
        android:paddingEnd="@dimen/launcher_spacing_xl"
        android:paddingBottom="@dimen/launcher_spacing_xxl">

        <TextView
            android:id="@+id/tv_setup_toolbar_title"
            style="@style/TextAppearance.OldLauncher.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/family_setup_toolbar_title" />

        <TextView
            android:id="@+id/tv_setup_title"
            style="@style/TextAppearance.OldLauncher.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xxl"
            android:text="@string/family_setup_title" />

        <TextView
            style="@style/TextAppearance.OldLauncher.StateBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_sm"
            android:text="@string/family_setup_description" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progress_setup"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="3"
                android:progress="0"
                android:progressBackgroundTint="@color/launcher_outline"
                android:progressTint="@color/launcher_action" />

            <TextView
                android:id="@+id/tv_setup_progress"
                style="@style/TextAppearance.OldLauncher.Meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/launcher_spacing_md"
                android:textStyle="bold"
                tools:text="已完成 0 / 3" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="0dp"
            app:strokeColor="@color/launcher_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/launcher_spacing_lg">

                    <TextView
                        android:id="@+id/tv_setup_contacts_title"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_settings_category_contacts"
                        android:drawablePadding="@dimen/launcher_spacing_md"
                        android:drawableTint="@color/launcher_primary"
                        android:gravity="center_vertical"
                        android:text="@string/family_setup_contacts_title" />

                    <TextView
                        style="@style/TextAppearance.OldLauncher.SectionSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        android:text="@string/family_setup_contacts_description" />

                    <TextView
                        android:id="@+id/tv_setup_contacts_status"
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_md"
                        android:textStyle="bold"
                        tools:text="未完成：还没有电话联系人" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_setup_contacts"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="@dimen/launcher_spacing_lg"
                        android:text="@string/family_setup_action_contacts"
                        android:textAllCaps="false"
                        
                        android:textColor="@color/launcher_primary_dark"
                        app:backgroundTint="@color/launcher_surface"
                        app:cornerRadius="@dimen/launcher_radius_md"
                        app:strokeColor="@color/launcher_outline" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/launcher_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/launcher_spacing_lg">

                    <TextView
                        android:id="@+id/tv_setup_permission_title"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_settings_category_permissions"
                        android:drawablePadding="@dimen/launcher_spacing_md"
                        android:drawableTint="@color/launcher_primary"
                        android:gravity="center_vertical"
                        android:text="@string/family_setup_permission_title" />

                    <TextView
                        style="@style/TextAppearance.OldLauncher.SectionSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        android:text="@string/family_setup_permission_description" />

                    <TextView
                        android:id="@+id/tv_setup_permission_status"
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_md"
                        android:textStyle="bold"
                        tools:text="未完成：需要开启电话权限" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_setup_permission"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="@dimen/launcher_spacing_lg"
                        android:text="@string/family_setup_action_permission"
                        android:textAllCaps="false"
                        
                        android:textColor="@color/launcher_primary_dark"
                        app:backgroundTint="@color/launcher_surface"
                        app:cornerRadius="@dimen/launcher_radius_md"
                        app:strokeColor="@color/launcher_outline" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/launcher_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/launcher_spacing_lg">

                    <TextView
                        android:id="@+id/tv_setup_launcher_title"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_settings_category_device"
                        android:drawablePadding="@dimen/launcher_spacing_md"
                        android:drawableTint="@color/launcher_primary"
                        android:gravity="center_vertical"
                        android:text="@string/family_setup_launcher_title" />

                    <TextView
                        style="@style/TextAppearance.OldLauncher.SectionSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        android:text="@string/family_setup_launcher_description" />

                    <TextView
                        android:id="@+id/tv_setup_launcher_status"
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_md"
                        android:textStyle="bold"
                        tools:text="未完成：银杏还不是默认桌面" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_setup_launcher"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="@dimen/launcher_spacing_lg"
                        android:text="@string/family_setup_action_launcher"
                        android:textAllCaps="false"
                        
                        android:textColor="@color/launcher_primary_dark"
                        app:backgroundTint="@color/launcher_surface"
                        app:cornerRadius="@dimen/launcher_radius_md"
                        app:strokeColor="@color/launcher_outline" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_setup_finish_hint"
            style="@style/TextAppearance.OldLauncher.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            android:gravity="center"
            android:text="@string/family_setup_finish_pending" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_setup_finish"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            android:enabled="false"
            android:text="@string/family_setup_finish"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.OldLauncher.ButtonPrimary"
            app:backgroundTint="@color/launcher_action_dark"
            app:cornerRadius="@dimen/launcher_radius_md" />

        <TextView
            style="@style/TextAppearance.OldLauncher.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_lg"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/launcher_spacing_xs"
            android:text="@string/family_setup_optional_note" />
    </LinearLayout>
</ScrollView>
