<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/launcher_spacing_xl"
        android:paddingTop="@dimen/launcher_spacing_md"
        android:paddingEnd="@dimen/launcher_spacing_xl"
        android:paddingBottom="@dimen/launcher_spacing_xxl">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_detail_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/launcher_spacing_md"
                    android:src="@drawable/ic_settings_action_back"
                    app:tint="@color/launcher_primary_dark" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/settings_detail_page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.OldLauncher.PageTitle"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/settings_detail_page_subtitle"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_about_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            android:visibility="gone"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="84dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/launcher_spacing_md"
                android:paddingTop="@dimen/launcher_spacing_md"
                android:paddingEnd="@dimen/launcher_spacing_md"
                android:paddingBottom="@dimen/launcher_spacing_md">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/launcher_spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settings_about_hero_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.CardTitle"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/settings_about_hero_version"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.Caption"
                        android:layout_marginTop="@dimen/launcher_spacing_xs" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.Caption"
                        android:layout_marginTop="@dimen/launcher_spacing_xs"
                        android:maxLines="1"
                        android:text="@string/settings_about_hero_subtitle" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_about_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            android:visibility="gone"
            app:cardBackgroundColor="@color/launcher_surface_soft"
            app:cardCornerRadius="@dimen/launcher_radius_sm"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/launcher_spacing_xs">

                <TextView
                    android:id="@+id/settings_about_tab_project"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_about_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingStart="@dimen/launcher_spacing_sm"
                    android:paddingEnd="@dimen/launcher_spacing_sm"
                    style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                    android:text="@string/settings_about_tab_project"
                    android:textColor="@color/settings_about_tab_text"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/settings_about_tab_evidence"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_about_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingStart="@dimen/launcher_spacing_sm"
                    android:paddingEnd="@dimen/launcher_spacing_sm"
                    style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                    android:text="@string/settings_about_tab_evidence"
                    android:textColor="@color/settings_about_tab_text"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/settings_about_tab_service"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_about_tab"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingStart="@dimen/launcher_spacing_sm"
                    android:paddingEnd="@dimen/launcher_spacing_sm"
                    style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                    android:text="@string/settings_about_tab_service"
                    android:textColor="@color/settings_about_tab_text"
                    android:textStyle="normal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_detail_card_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/settings_detail_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/bg_settings_group_divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_detail_card_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            android:visibility="gone"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/settings_detail_rows_secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/bg_settings_group_divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_detail_card_tertiary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            android:visibility="gone"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:id="@+id/settings_detail_rows_tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/bg_settings_group_divider"
                android:orientation="vertical"
                android:showDividers="middle" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
