<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_item"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:layout_marginHorizontal="@dimen/launcher_spacing_sm"
    android:layout_marginVertical="@dimen/launcher_spacing_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/launcher_surface"
    app:cardCornerRadius="@dimen/launcher_radius_lg"
    app:cardElevation="4dp"
    app:strokeColor="@color/launcher_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/launcher_spacing_lg"
        android:paddingTop="@dimen/launcher_spacing_xxl"
        android:paddingEnd="@dimen/launcher_spacing_lg"
        android:paddingBottom="@dimen/launcher_spacing_xl">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:background="@null"
            android:contentDescription="@null"
            android:padding="@dimen/launcher_spacing_lg"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/name"
            style="@style/TextAppearance.OldLauncher.CardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2" />


    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
