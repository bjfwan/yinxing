<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/phone_contact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page_gradient"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/launcher_spacing_lg"
    android:paddingTop="@dimen/launcher_spacing_md"
    android:paddingEnd="@dimen/launcher_spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="true"
            android:contentDescription="@string/action_back"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="@dimen/launcher_spacing_lg"
                android:src="@drawable/ic_settings_action_back"
                app:tint="@color/launcher_primary_dark" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/launcher_spacing_md"
            android:layout_marginEnd="@dimen/launcher_spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_page_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.OldLauncher.PageTitle"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/phone_contact_title" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_mode_action"
            android:layout_width="76dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingStart="@dimen/launcher_spacing_lg"
            android:paddingEnd="@dimen/launcher_spacing_lg"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_mode_action"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_settings_primary_capsule"
                android:gravity="center"
                style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                android:text="@string/action_manage" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layout_manage_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_sm"
        android:visibility="gone"
        app:cardBackgroundColor="@color/launcher_surface"
        app:cardCornerRadius="@dimen/launcher_radius_md"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/launcher_spacing_lg">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_add_contact"
                style="@style/Widget.OldLauncher.DialogButtonSuccess"
                android:layout_width="match_parent"
                android:layout_height="@dimen/launcher_dialog_button_height">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_person_add" />

                    <TextView
                        style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/launcher_spacing_sm"
                        android:text="@string/action_add_contact" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/launcher_spacing_md"
                android:background="@color/launcher_divider" />

            <LinearLayout
                android:id="@+id/layout_display_mode"
                android:layout_marginTop="@dimen/launcher_spacing_md"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_settings_mode_capsule"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/launcher_spacing_lg"
                android:paddingEnd="@dimen/launcher_spacing_lg">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_plate_soft"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/launcher_spacing_sm"
                    android:src="@drawable/ic_grid_view" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/launcher_spacing_md"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    style="@style/TextAppearance.OldLauncher.Meta"
                    android:text="@string/phone_contact_layout_title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segmented_track"
                    android:orientation="horizontal"
                    android:padding="@dimen/launcher_spacing_xs">

                    <TextView
                        android:id="@+id/btn_layout_large"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_segmented_item_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/launcher_spacing_sm"
                        android:paddingEnd="@dimen/launcher_spacing_sm"
                        style="@style/TextAppearance.OldLauncher.Badge"
                        android:text="@string/phone_contact_layout_large" />

                    <TextView
                        android:id="@+id/btn_layout_grid"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="@dimen/launcher_spacing_xs"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="@dimen/launcher_spacing_sm"
                        android:paddingEnd="@dimen/launcher_spacing_sm"
                        style="@style/TextAppearance.OldLauncher.Badge"
                        android:text="@string/phone_contact_layout_grid" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_manage_search"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="@dimen/launcher_spacing_sm"
                android:background="@drawable/edit_text_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/launcher_spacing_lg"
                android:paddingEnd="@dimen/launcher_spacing_sm">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/et_contact_search"
                    style="@style/TextAppearance.OldLauncher.Input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/launcher_spacing_sm"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/contact_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/btn_clear_search"
                    android:layout_width="60dp"
                    android:layout_height="42dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    style="@style/TextAppearance.OldLauncher.ButtonSecondary"
                    android:text="@string/action_clear"
                    android:textColor="@color/launcher_primary"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/launcher_spacing_sm"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_phone_contacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/launcher_spacing_xl" />

        <com.yinxing.launcher.common.ui.PageStateView
            android:id="@+id/view_page_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
