<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_phone_contact"
    android:layout_width="match_parent"
    android:layout_height="232dp"
    android:layout_marginStart="2dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="7dp"
    android:clickable="false"
    android:focusable="false"
    app:cardBackgroundColor="@color/launcher_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/launcher_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            android:layout_width="164dp"
            android:layout_height="164dp"
            android:background="@color/launcher_surface_soft"
            android:contentDescription="@string/contact_photo_preview"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.OldLauncher.ContactPhoto" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_contact_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/contact_name_placeholder"
                android:textColor="@color/launcher_text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_contact_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/launcher_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="138 0013 8000" />

            <TextView
                android:id="@+id/tv_auto_answer_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_auto_answer_chip"
                android:drawableStart="@drawable/ic_settings_category_calls"
                android:drawableTint="@color/launcher_call"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:minHeight="28dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/contact_auto_answer_badge"
                android:textColor="@color/launcher_call"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="76dp"
                android:minWidth="0dp"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:text="@string/action_call"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                app:backgroundTint="@color/launcher_phone_action"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_settings_category_calls"
                app:iconGravity="textStart"
                app:iconPadding="5dp"
                app:iconSize="22dp"
                app:iconTint="@android:color/white" />

            <TextView
                android:id="@+id/tv_manage_hint"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_settings_mode_capsule"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/contact_manage_hint_edit"
                android:textColor="@color/launcher_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
