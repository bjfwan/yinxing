<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.OldLauncher.DialogSurfaceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/launcher_dialog_content_padding_compact">

        <TextView
            style="@style/TextAppearance.OldLauncher.DialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/avatar_editor_title" />

        <com.yinxing.launcher.common.ui.AvatarCropView
            android:id="@+id/avatar_crop_view"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="@dimen/launcher_dialog_section_gap"
            android:contentDescription="@string/avatar_crop_preview" />

        <TextView
            style="@style/TextAppearance.OldLauncher.DialogSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/avatar_crop_tip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/launcher_dialog_button_height"
            android:layout_marginTop="@dimen/launcher_dialog_section_gap"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_avatar_cancel"
                style="@style/Widget.OldLauncher.DialogButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <TextView
                    style="@style/TextAppearance.OldLauncher.DialogActionSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/action_cancel" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_avatar_confirm"
                style="@style/Widget.OldLauncher.DialogButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tv_avatar_confirm"
                    style="@style/TextAppearance.OldLauncher.DialogActionPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/action_use_photo" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
