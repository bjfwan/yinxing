<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.OldLauncher.DialogSurfaceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/launcher_dialog_content_padding">

        <TextView
            style="@style/TextAppearance.OldLauncher.DialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/settings_contact_dialog_title" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_dialog_phone_contacts"
            style="@style/Widget.OldLauncher.DialogButtonSuccess"
            android:layout_width="match_parent"
            android:layout_height="@dimen/launcher_dialog_button_height"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings_category_calls"
                    app:tint="@android:color/white" />

                <TextView
                    style="@style/TextAppearance.OldLauncher.DialogActionPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/settings_open_phone_contacts" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_dialog_video_contacts"
            style="@style/Widget.OldLauncher.DialogButtonSuccess"
            android:layout_width="match_parent"
            android:layout_height="@dimen/launcher_dialog_button_height"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_settings_action_video"
                    app:tint="@android:color/white" />

                <TextView
                    style="@style/TextAppearance.OldLauncher.DialogActionPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/settings_open_video_contacts" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_dialog_contacts_cancel"
            style="@style/Widget.OldLauncher.DialogButtonSecondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/launcher_dialog_button_height"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/TextAppearance.OldLauncher.DialogActionSecondary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/action_cancel" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
