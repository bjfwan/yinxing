<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/launcher_spacing_sm"
        android:paddingTop="@dimen/launcher_spacing_md"
        android:paddingEnd="@dimen/launcher_spacing_sm"
        android:paddingBottom="@dimen/launcher_spacing_xxl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_elder_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="0dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/launcher_spacing_sm"
                    android:src="@drawable/ic_settings_action_back"
                    app:tint="@color/launcher_primary_dark" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/launcher_spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/settings_overlay_title"
                    style="@style/TextAppearance.OldLauncher.PageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_elder_title" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_switch_standard"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/edit_text_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="72dp"
                android:paddingStart="@dimen/launcher_spacing_md"
                android:paddingEnd="@dimen/launcher_spacing_md"
                style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                android:text="@string/settings_switch_standard"
                android:textColor="@color/launcher_primary_dark" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="1dp"
            app:strokeColor="@color/launcher_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/launcher_spacing_lg">

                <com.yinxing.launcher.feature.settings.SettingsProgressView
                    android:id="@+id/tv_elder_progress_count"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    style="@style/TextAppearance.OldLauncher.Badge"
                    android:gravity="center" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/launcher_spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:text="@string/settings_elder_progress" />

                    <TextView
                        android:id="@+id/tv_elder_pending_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        android:textColor="@color/launcher_warning" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_elder_guard"
                android:layout_width="0dp"
                android:layout_height="@dimen/settings_elder_action_card_height"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/launcher_surface"
                app:cardCornerRadius="@dimen/launcher_radius_md"
                app:cardElevation="1dp"
                app:strokeColor="@color/launcher_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/launcher_spacing_md">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_settings_icon_plate"
                        android:backgroundTint="@color/launcher_call_soft"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/launcher_spacing_sm"
                        android:src="@drawable/ic_settings_category_calls"
                        app:tint="@color/launcher_call" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:text="@string/settings_calls_title" />

                    <TextView
                        android:id="@+id/tv_elder_guard_summary"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/launcher_spacing_xs"
                        android:layout_weight="1"
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_settings_elder_action"
                        android:gravity="center"
                        style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                        android:text="@string/settings_continue_setup" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_elder_contacts"
                android:layout_width="0dp"
                android:layout_height="@dimen/settings_elder_action_card_height"
                android:layout_marginStart="@dimen/launcher_spacing_md"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/launcher_surface"
                app:cardCornerRadius="@dimen/launcher_radius_md"
                app:cardElevation="2dp"
                app:strokeColor="@color/launcher_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/launcher_spacing_md">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_settings_icon_plate"
                        android:backgroundTint="@color/launcher_contacts_soft"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/launcher_spacing_sm"
                        android:src="@drawable/ic_settings_category_contacts"
                        app:tint="@color/launcher_contacts" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:text="@string/settings_elder_contacts" />

                    <TextView
                        android:id="@+id/tv_elder_contacts_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:layout_marginTop="@dimen/launcher_spacing_sm" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_elder_system"
                android:layout_width="0dp"
                android:layout_height="@dimen/settings_elder_action_card_height"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/launcher_surface"
                app:cardCornerRadius="@dimen/launcher_radius_md"
                app:cardElevation="1dp"
                app:strokeColor="@color/launcher_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/launcher_spacing_md">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_settings_icon_plate"
                        android:backgroundTint="@color/launcher_system_soft"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/launcher_spacing_sm"
                        android:src="@drawable/ic_settings_category_system"
                        app:tint="@color/launcher_system" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:text="@string/settings_elder_system" />

                    <TextView
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:id="@+id/tv_elder_city"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_xs" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_elder_device"
                android:layout_width="0dp"
                android:layout_height="@dimen/settings_elder_action_card_height"
                android:layout_marginStart="@dimen/launcher_spacing_md"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardBackgroundColor="@color/launcher_surface"
                app:cardCornerRadius="@dimen/launcher_radius_md"
                app:cardElevation="1dp"
                app:strokeColor="@color/launcher_outline"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/launcher_spacing_md">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_settings_icon_plate"
                        android:backgroundTint="@color/launcher_device_soft"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/launcher_spacing_sm"
                        android:src="@drawable/ic_settings_category_device"
                        app:tint="@color/launcher_device" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_sm"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:text="@string/settings_elder_device" />

                    <TextView
                        android:id="@+id/tv_elder_device_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:layout_marginTop="@dimen/launcher_spacing_xs"
                        android:textColor="@color/launcher_warning" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="1dp"
            app:strokeColor="@color/launcher_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="70dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/launcher_spacing_lg"
                android:paddingTop="@dimen/launcher_spacing_sm"
                android:paddingEnd="@dimen/launcher_spacing_md"
                android:paddingBottom="@dimen/launcher_spacing_sm">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon_plate"
                    android:backgroundTint="@color/launcher_call_soft"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/launcher_spacing_md"
                    android:src="@drawable/ic_settings_category_calls"
                    app:tint="@color/launcher_call" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/launcher_spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:text="@string/settings_auto_answer_title" />

                    <TextView
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:id="@+id/tv_elder_auto_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_xs" />
                </LinearLayout>

                <com.yinxing.launcher.feature.settings.SettingsToggle
                    android:id="@+id/switch_elder_auto_answer"
                    android:layout_width="42dp"
                    android:layout_height="32dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            app:cardBackgroundColor="@color/launcher_surface"
            app:cardCornerRadius="@dimen/launcher_radius_md"
            app:cardElevation="1dp"
            app:strokeColor="@color/launcher_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="76dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/launcher_spacing_lg"
                android:paddingTop="@dimen/launcher_spacing_sm"
                android:paddingEnd="@dimen/launcher_spacing_md"
                android:paddingBottom="@dimen/launcher_spacing_sm">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_settings_icon_plate"
                    android:backgroundTint="@color/launcher_danger_soft"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/launcher_spacing_md"
                    android:src="@drawable/ic_settings_action_warning"
                    app:tint="@color/launcher_danger" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/launcher_spacing_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.OldLauncher.ListTitle"
                        android:text="@string/settings_fall_detection_title" />

                    <TextView
                        style="@style/TextAppearance.OldLauncher.Meta"
                        android:id="@+id/tv_elder_fall_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_xs" />
                </LinearLayout>

                <com.yinxing.launcher.feature.settings.SettingsToggle
                    android:id="@+id/switch_elder_fall_detection"
                    android:layout_width="42dp"
                    android:layout_height="32dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/btn_elder_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_md"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="52dp"
            style="@style/TextAppearance.OldLauncher.ButtonSecondary"
            android:text="@string/settings_about_entry"
            android:textColor="@color/launcher_text_secondary" />
    </LinearLayout>
</ScrollView>
