<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tv_day_relative"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:textColor="@color/launcher_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_day_weekday"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="15sp" />

    <ImageView
        android:id="@+id/iv_day_weather"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tv_day_condition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/launcher_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_day_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/launcher_text_primary"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="3dp"
        android:paddingEnd="3dp"
        android:text="/"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_day_low"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/launcher_text_secondary"
        android:textSize="18sp" />
</LinearLayout>
