<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/launcher_spacing_sm"
    android:paddingBottom="@dimen/launcher_spacing_sm">

    <TextView
        android:id="@+id/tv_day_relative"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.OldLauncher.Meta"
        android:textColor="@color/launcher_text_primary"
        android:textStyle="bold" />

    <TextView
        style="@style/TextAppearance.OldLauncher.Caption"
        android:id="@+id/tv_day_weekday"
        android:layout_width="40dp"
        android:layout_height="wrap_content" />

    <ImageView
        android:id="@+id/iv_day_weather"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tv_day_condition"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/launcher_spacing_sm"
        android:layout_weight="1"
        style="@style/TextAppearance.OldLauncher.Meta"
        android:textColor="@color/launcher_text_primary"
        android:textStyle="bold" />

    <TextView
        style="@style/TextAppearance.OldLauncher.ListTitle"
        android:id="@+id/tv_day_high"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/launcher_spacing_xs"
        android:paddingEnd="@dimen/launcher_spacing_xs"
        style="@style/TextAppearance.OldLauncher.Meta"
        android:text="/" />

    <TextView
        style="@style/TextAppearance.OldLauncher.Meta"
        android:id="@+id/tv_day_low"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
</LinearLayout>
