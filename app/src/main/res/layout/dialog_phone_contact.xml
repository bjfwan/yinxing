<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.OldLauncher.DialogSurfaceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/launcher_dialog_content_padding_compact">

            <TextView
                android:id="@+id/tv_dialog_title"
                style="@style/TextAppearance.OldLauncher.DialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/phone_contact_dialog_add_title" />

            <LinearLayout
                android:id="@+id/layout_contact_identity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_photo_preview"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@color/launcher_surface_soft"
                    android:contentDescription="@string/contact_photo_preview"
                    android:padding="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_contact_avatar_placeholder"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.OldLauncher.ContactPhoto" />

                <TextView
                    style="@style/TextAppearance.OldLauncher.DialogSupporting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="@string/contact_dialog_avatar_tip_short" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/launcher_dialog_button_height"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_pick_contact"
                    style="@style/Widget.OldLauncher.DialogButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TextAppearance.OldLauncher.DialogActionSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/action_pick_contact_short" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_select_photo"
                    style="@style/Widget.OldLauncher.DialogButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TextAppearance.OldLauncher.DialogActionSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/action_edit_avatar" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_settings_mode_capsule"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_name" />

                <EditText
                    android:id="@+id/et_name"
                    style="@style/TextAppearance.OldLauncher.DialogInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/launcher_dialog_control_height"
                    android:layout_marginTop="8dp"
                    android:autofillHints="personName"
                    android:background="@drawable/edit_text_background_focused"
                    android:hint="@string/hint_name"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <TextView
                    style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/label_phone" />

                <EditText
                    android:id="@+id/et_phone"
                    style="@style/TextAppearance.OldLauncher.DialogInput"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/launcher_dialog_control_height"
                    android:layout_marginTop="8dp"
                    android:autofillHints="phone"
                    android:background="@drawable/edit_text_background_focused"
                    android:hint="@string/hint_phone"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.OldLauncher.DialogContentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/contact_auto_answer_label" />

                        <TextView
                            style="@style/TextAppearance.OldLauncher.DialogSupporting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/contact_auto_answer_tip_short" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/sw_auto_answer"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/launcher_dialog_control_height"
                        android:layout_marginStart="12dp"
                        android:contentDescription="@string/contact_auto_answer_label"
                        android:minHeight="@dimen/launcher_dialog_control_height"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/launcher_dialog_button_height"
                android:layout_marginTop="@dimen/launcher_dialog_section_gap"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.OldLauncher.DialogButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/btn_cancel_label"
                        style="@style/TextAppearance.OldLauncher.DialogActionSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/action_cancel" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_confirm"
                    style="@style/Widget.OldLauncher.DialogButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TextAppearance.OldLauncher.DialogActionPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/action_save" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
