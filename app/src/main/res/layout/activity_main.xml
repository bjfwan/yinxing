<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page_gradient"
    android:orientation="vertical"
    android:paddingStart="@dimen/launcher_spacing_lg"
    android:paddingTop="@dimen/launcher_spacing_sm"
    android:paddingEnd="@dimen/launcher_spacing_lg"
    android:paddingBottom="@dimen/launcher_spacing_md"
    tools:context=".feature.home.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.OldLauncher.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_family_settings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="100dp"
            android:text="@string/home_caregiver_entry"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.OldLauncher.ButtonSecondary"
            android:textColor="@color/launcher_primary_dark"
            app:cornerRadius="@dimen/launcher_radius_md"
            app:icon="@drawable/ic_settings_category_system"
            app:iconPadding="@dimen/launcher_spacing_sm"
            app:iconSize="18dp"
            app:iconTint="@color/launcher_text_secondary"
            app:strokeColor="@color/launcher_outline"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.OldLauncher.PageHeroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/launcher_spacing_lg">

            <TextView
                android:id="@+id/tv_time"
                style="@style/TextAppearance.OldLauncher.HeroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/home_time_placeholder" />

            <LinearLayout
                android:id="@+id/layout_calendar_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_sm"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_date"
                    style="@style/TextAppearance.OldLauncher.Date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/home_date_placeholder" />

                <TextView
                    android:id="@+id/tv_lunar"
                    style="@style/TextAppearance.OldLauncher.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/launcher_spacing_sm"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/launcher_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/launcher_spacing_md"
                android:background="@color/launcher_outline" />

            <include
                android:id="@+id/card_weather"
                layout="@layout/item_home_weather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_sm" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_home_status"
        style="@style/Widget.OldLauncher.PageHeroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/launcher_spacing_md"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/launcher_spacing_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progress_home_status"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="@dimen/launcher_spacing_md"
                    android:indeterminateTint="@color/launcher_action"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_home_status_title"
                    style="@style/TextAppearance.OldLauncher.StateTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="正在整理首页" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_home_status_message"
                style="@style/TextAppearance.OldLauncher.StateBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_md"
                tools:text="常用入口马上就好" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_home_status_action"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_sm"
                android:textAllCaps="false"
                android:textColor="@color/launcher_action"
                android:visibility="gone"
                tools:text="重新加载"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/launcher_spacing_sm"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/launcher_spacing_sm" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_adjust_home"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:contentDescription="@string/home_adjust_description"
        android:text="@string/home_adjust_entry"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.OldLauncher.ButtonSecondary"
        android:textColor="@color/launcher_primary_dark"
        app:backgroundTint="@color/launcher_surface"
        app:cornerRadius="@dimen/launcher_radius_lg"
        app:icon="@drawable/ic_settings_device_scale"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/launcher_spacing_md"
        app:iconSize="24dp"
        app:iconTint="@color/launcher_phone_action"
        app:strokeColor="@color/launcher_outline"
        app:strokeWidth="1dp" />

</LinearLayout>
