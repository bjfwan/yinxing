<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="@dimen/launcher_spacing_xxl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/icon_background"
            android:padding="@dimen/launcher_spacing_xxl">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/incoming_call_icon_description"
                android:src="@android:drawable/ic_menu_call"
                app:tint="@color/launcher_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_incoming_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xxl"
            style="@style/TextAppearance.OldLauncher.DialogTitle"
            android:text="@string/incoming_call_subtitle" />

        <TextView
            android:id="@+id/tv_incoming_caller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            style="@style/TextAppearance.OldLauncher.HeroTitle"
            android:text="@string/incoming_call_unknown_caller" />

        <TextView
            android:id="@+id/tv_incoming_risk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xl"
            android:background="@drawable/bg_incoming_risk_chip"
            android:gravity="center"
            android:paddingStart="@dimen/launcher_spacing_lg"
            android:paddingTop="@dimen/launcher_spacing_sm"
            android:paddingEnd="@dimen/launcher_spacing_lg"
            android:paddingBottom="@dimen/launcher_spacing_sm"
            style="@style/TextAppearance.OldLauncher.DialogTitle"
            android:textColor="@color/launcher_warning"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_incoming_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xxl"
            android:background="@drawable/edit_text_background"
            android:gravity="center"
            android:paddingStart="@dimen/launcher_spacing_xl"
            android:paddingTop="@dimen/launcher_spacing_md"
            android:paddingEnd="@dimen/launcher_spacing_xl"
            android:paddingBottom="@dimen/launcher_spacing_md"
            style="@style/TextAppearance.OldLauncher.DialogTitle"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/launcher_spacing_xxl"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_incoming_decline"
                style="@style/Widget.OldLauncher.DialogButtonDanger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/launcher_spacing_md"
                android:layout_weight="1"
                android:contentDescription="@string/incoming_call_decline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="124dp"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/launcher_spacing_xl"
                    android:paddingTop="@dimen/launcher_spacing_lg"
                    android:paddingEnd="@dimen/launcher_spacing_xl"
                    android:paddingBottom="@dimen/launcher_spacing_lg">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/incoming_call_decline"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_incoming_decline_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_md"
                        style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                        android:text="@string/incoming_call_decline" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_incoming_accept"
                style="@style/Widget.OldLauncher.DialogButtonSuccess"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/launcher_spacing_md"
                android:layout_weight="1"
                android:contentDescription="@string/incoming_call_accept">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="124dp"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/launcher_spacing_xl"
                    android:paddingTop="@dimen/launcher_spacing_lg"
                    android:paddingEnd="@dimen/launcher_spacing_xl"
                    android:paddingBottom="@dimen/launcher_spacing_lg">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/incoming_call_accept"
                        android:src="@android:drawable/sym_action_call"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tv_incoming_accept_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/launcher_spacing_md"
                        style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                        android:text="@string/incoming_call_accept" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
