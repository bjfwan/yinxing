<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.OldLauncher.DialogSurfaceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/launcher_dialog_content_padding_compact">

            <TextView
                style="@style/TextAppearance.OldLauncher.DialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_user_report_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_dialog_title_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/user_report_privacy_warning"
                    style="@style/TextAppearance.OldLauncher.DialogMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_user_report_message" />

                <TextView
                    android:id="@+id/user_report_privacy_toggle"
                    style="@style/TextAppearance.OldLauncher.DialogSectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/launcher_dialog_control_height"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/settings_user_report_privacy_show"
                    android:textColor="@color/launcher_action_dark" />
            </LinearLayout>

            <TextView
                android:id="@+id/user_report_privacy_details"
                style="@style/TextAppearance.OldLauncher.DialogSupporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/settings_user_report_privacy_details"
                android:visibility="gone" />

            <TextView
                android:id="@+id/user_report_type"
                style="@style/TextAppearance.OldLauncher.DialogInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/launcher_dialog_control_height"
                android:layout_marginTop="@dimen/launcher_dialog_section_gap"
                android:background="@drawable/edit_text_background"
                android:clickable="true"
                android:contentDescription="@string/settings_user_report_type"
                android:drawableEnd="@drawable/ic_settings_expand_more"
                android:drawablePadding="10dp"
                android:drawableTint="@color/launcher_text_secondary"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/settings_user_report_type_default" />

            <EditText
                android:id="@+id/user_report_description"
                style="@style/TextAppearance.OldLauncher.DialogInput"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_background"
                android:gravity="start|top"
                android:hint="@string/settings_user_report_description_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="800"
                android:padding="14dp" />

            <TextView
                android:id="@+id/user_report_error"
                style="@style/TextAppearance.OldLauncher.DialogSupporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_user_report_required"
                android:textColor="@color/launcher_danger"
                android:visibility="gone" />

            <EditText
                android:id="@+id/user_report_steps"
                style="@style/TextAppearance.OldLauncher.DialogInput"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/edit_text_background"
                android:gravity="start|top"
                android:hint="@string/settings_user_report_steps_hint"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="800"
                android:padding="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_dialog_section_gap"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/user_report_cancel"
                    style="@style/Widget.OldLauncher.DialogButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/launcher_dialog_button_height"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TextAppearance.OldLauncher.DialogActionSecondary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/action_cancel" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/user_report_submit"
                    style="@style/Widget.OldLauncher.DialogButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/launcher_dialog_button_height"
                    android:layout_marginStart="@dimen/launcher_dialog_action_gap"
                    android:layout_weight="1">

                    <TextView
                        style="@style/TextAppearance.OldLauncher.DialogActionPrimary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="@string/settings_user_report_submit" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.card.MaterialCardView>
