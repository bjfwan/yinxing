<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/weather_city_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_settings_page_gradient"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="72dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/launcher_spacing_sm"
            android:background="@drawable/bg_weather_toolbar_action"
            android:contentDescription="@string/weather_detail_back"
            android:padding="@dimen/launcher_spacing_lg"
            android:src="@drawable/ic_weather_detail_back"
            app:tint="@color/launcher_primary_dark" />

        <TextView
            android:id="@+id/tv_city_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            style="@style/TextAppearance.OldLauncher.PageTitle"
            android:text="@string/weather_city_title" />

        <TextView
            android:id="@+id/btn_manage"
            android:layout_width="88dp"
            android:layout_height="56dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/launcher_spacing_sm"
            android:background="@drawable/bg_weather_toolbar_action"
            android:gravity="center"
            style="@style/TextAppearance.OldLauncher.ButtonSecondary"
            android:text="@string/weather_city_manage"
            android:textColor="@color/launcher_text_primary" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/btn_use_current_location"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="@dimen/launcher_spacing_lg"
        android:layout_marginEnd="@dimen/launcher_spacing_lg"
        android:layout_marginBottom="@dimen/launcher_spacing_md"
        android:background="@drawable/bg_weather_city_location"
        android:clickable="true"
        android:contentDescription="@string/weather_city_use_current_location"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_use_current_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            style="@style/TextAppearance.OldLauncher.ListTitle"
            android:text="@string/weather_city_use_current_location" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/city_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/launcher_spacing_lg"
            android:paddingEnd="@dimen/launcher_spacing_lg"
            android:paddingBottom="@dimen/launcher_spacing_md" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/btn_search_city"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginStart="@dimen/launcher_spacing_xl"
        android:layout_marginTop="@dimen/launcher_spacing_md"
        android:layout_marginEnd="@dimen/launcher_spacing_xl"
        android:layout_marginBottom="@dimen/launcher_spacing_md"
        android:background="@drawable/bg_weather_city_search"
        android:clickable="true"
        android:contentDescription="@string/weather_city_search_entry"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_add_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            style="@style/TextAppearance.OldLauncher.ButtonPrimary"
            android:text="@string/weather_city_search_entry" />
    </LinearLayout>
</LinearLayout>
