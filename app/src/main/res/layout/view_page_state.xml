<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="@dimen/launcher_spacing_xxl"
        style="@style/Widget.OldLauncher.PageHeroCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/launcher_spacing_xxl">

            <TextView
                android:id="@+id/tv_page_state_title"
                style="@style/TextAppearance.OldLauncher.StateTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxWidth="360dp" />

            <TextView
                android:id="@+id/tv_page_state_message"
                style="@style/TextAppearance.OldLauncher.StateBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_md"
                android:gravity="center"
                android:maxWidth="360dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_page_state_action"
                style="@style/Widget.OldLauncher.DialogButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/launcher_spacing_xxl"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_page_state_action"
                    style="@style/TextAppearance.OldLauncher.ButtonPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/launcher_spacing_xxl"
                    android:paddingTop="@dimen/launcher_spacing_md"
                    android:paddingEnd="@dimen/launcher_spacing_xxl"
                    android:paddingBottom="@dimen/launcher_spacing_md" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</merge>
